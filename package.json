{
  "name": "hiring-fullstack-todo",
  "version": "1.0.0",
  "description": "A full-stack TODO app built with React, Express and MongoDB.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "npm run test --workspaces --if-present"
  },
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wulfri-dng/hiring-fullstack-todo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wulfri-dng/hiring-fullstack-todo/issues"
  },
  "homepage": "https://github.com/wulfri-dng/hiring-fullstack-todo#readme",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
